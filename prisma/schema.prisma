// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GreetingType {
  MORNING
  AFTERNOON
}

enum CatchupTier {
  QUICK_FIX
  FULL_BACKLOG
  VIP_DEFENSE
}

enum TimeframeType {
  WEEKS
  MONTHS
}

enum CatchupPaymentStatus {
  PENDING
  PAID
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                 Int             @id @default(autoincrement())
  telegramId         BigInt          @unique
  firstName          String
  username           String?
  paymentEmail       String?
  // The user's job role and department at their industrial placement, e.g.
  // "network support intern, IT department". Renamed from `courseOfStudy`.
  workplaceRole      String?
  logFrequency       String // "daily" | "bi-daily" | "every-3-days" | "weekly"
  reminderTime       String // "HH:MM" in 24hr format
  timezone           String          @default("Africa/Lagos")
  isPro              Boolean         @default(false) // legacy compatibility flag
  storageUnlocked    Boolean         @default(false)
  // Meters the free storage allowance, NOT the total number of logs. Rescue Pass
  // (catch-up) logs are paid for separately and are excluded from this counter.
  logCount           Int             @default(0)
  nextRenewalDate    DateTime?
  freeAiRefinements  Int             @default(5) // 🚀 Bumped to 5
  freeVoiceLogs      Int             @default(5) // 🚀 Bumped to 5
  onboardingDone                Boolean         @default(false)
  firstLogPromptSent            Boolean         @default(false)
  firstLogCompletedInOnboarding Boolean         @default(false)
  hitPaywall                    Boolean         @default(false)
  botBlocked                    Boolean         @default(false)
  lastGreetingSentAt DateTime?
  lastGreetingType   GreetingType?
  nudgeCount         Int             @default(0)
  lastNudgeSentAt    DateTime?
  nudgingPaused      Boolean         @default(false)
  lastContactedAt    DateTime?
  createdAt          DateTime        @default(now())
  logs               Log[]
  reminderJobs       ReminderJob[]
  subscription       Subscription?
  manualPayments     ManualPayment[]
  paymentTransactions PaymentTransaction[]
  catchupSessions    CatchupSession[]

  @@index([logFrequency, onboardingDone, botBlocked, lastGreetingSentAt])
  @@index([lastGreetingType])
}

model Log {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
  content        String
  refinedContent String?
  logDate        DateTime
  isVoice        Boolean  @default(false)
  isAiRefined    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Backstop against concurrent catch-up fulfilment writing the same day twice.
  // NOTE: this keys on the exact timestamp, not the calendar day — catch-up logs
  // are normalised to midnight UTC, so it is only a true one-per-day guarantee
  // for those. Logs saved with a wall-clock time still need the app-level check.
  @@unique([userId, logDate])
}

model Subscription {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  paystackRef String   @unique
  status      String // "active" | "cancelled" | "expired"
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  subscriptionCode String? @unique
  customerCode     String?
}

model ReminderJob {
  id             Int       @id @default(autoincrement())
  cycleId        String?   @default(cuid())
  userId         Int
  user           User      @relation(fields: [userId], references: [id])
  telegramId     BigInt
  scheduledFor   DateTime
  status         String // "pending" | "sent" | "snoozed" | "skipped"
  snoozeCount    Int       @default(0)
  autoNudgeCount Int       @default(0)
  logDate        String? // ISO date "YYYY-MM-DD" the reminder is for (user's local date)
  bucketSent     String?
  sentAt         DateTime?
  convertedAt    DateTime?
  createdAt      DateTime  @default(now())
  reminderEvents ReminderEvent[]

  @@index([cycleId])
  @@index([userId, status, scheduledFor])
  @@index([status, scheduledFor])
  @@index([status, autoNudgeCount])
  @@index([sentAt])
}

model ReminderEvent {
  id            Int         @id @default(autoincrement())
  reminderJobId Int
  reminderJob   ReminderJob @relation(fields: [reminderJobId], references: [id])
  eventType     String // "sent" | "snoozed" | "skipped" | "converted" | "auto_nudged"
  createdAt     DateTime    @default(now())
  metadata      Json?

  @@index([reminderJobId, createdAt])
}

model Session {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model CatchupSession {
  id            String               @id @default(uuid())
  userId        Int
  user          User                 @relation(fields: [userId], references: [id])
  tierSelected  CatchupTier
  totalDuration  Int
  currentBlock  Int                  @default(1)
  startDate     DateTime
  contextDump   Json?
  paymentStatus CatchupPaymentStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, createdAt])
}

model ManualPayment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id        Int               @id @default(autoincrement())
  userId    Int
  user      User              @relation(fields: [userId], references: [id])
  amount    Int
  currency  String
  provider  String
  reference String            @unique
  metadata  Json?
  status    TransactionStatus @default(PENDING)
  paidAt    DateTime? // null until the charge is confirmed
  createdAt DateTime          @default(now())

  @@index([userId, paidAt])
  @@index([status])
}

model ReplayEvent {
  id         Int      @id @default(autoincrement())
  telegramId BigInt
  eventType  String // "user_message" | "user_voice" | "user_callback" | "bot_message" | "bot_photo" | "bot_edit" | "bot_callback_answer" | "error" | "state_change"
  direction  String // "incoming" | "outgoing" | "system"
  payload    String // JSON blob — full event data
  timestamp  DateTime @default(now())

  @@index([telegramId, timestamp(sort: Desc)])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// WeeklyQuote — one quote per IT week, shown in the Saturday recap message.
// weekNumber: 1-based (week 1 = first week of IT).
// attribution: optional name of the person who gave the quote.
// ---------------------------------------------------------------------------
model WeeklyQuote {
  id          Int     @id @default(autoincrement())
  weekNumber  Int     @unique
  quote       String
  attribution String?
}